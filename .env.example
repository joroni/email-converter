# Copy to .env for local development (netlify dev reads it). On Netlify, set these under
# Site configuration > Environment variables. Never commit the real .env.

# Figma personal access token (Figma > Settings > Security > Personal access tokens)
FIGMA_TOKEN=

# Anthropic API key (console.anthropic.com). Not needed if AI_PROVIDER=cli.
ANTHROPIC_API_KEY=

# Long random string used to sign login cookies, e.g. run: openssl rand -hex 32
SESSION_SECRET=

# First admin account, created automatically the first time the app runs with no users.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional
# AI_PROVIDER=cli                   # use the local "claude -p" CLI instead of the API (local dev only)
# ANTHROPIC_MODEL=claude-sonnet-5-5
